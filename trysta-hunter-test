import { ENGINE_CONFIG } from '../../config/constants.js';

/**
 * Advanced Camera System (10/10 Commercial Indie Standard)
 * รองรับ Dead Zone, Look Ahead, Dynamic Zoom, และ Trauma-based Multiple Shake
 */
export class Camera {
  constructor(mapWidth, mapHeight) {
    // พิกัดตำแหน่งพิกเซลจริงในโลก (World Space)
    this.x = 0;
    this.y = 0;
    this.width = ENGINE_CONFIG.CANVAS_WIDTH;
    this.height = ENGINE_CONFIG.CANVAS_HEIGHT;
    this.mapWidth = mapWidth;
    this.mapHeight = mapHeight;

    // ระบบควบคุมทิศทางและเป้าหมาย (Target Queue System)
    this.target = null;
    this.offsetX = 0;
    this.offsetY = 0;

    // 1. ระบบขอบเขตผ่อนแรง (Dead Zone Setup)
    this.deadZone = { x: 0, y: 0, width: 120, height: 90 };

    // 2. ระบบมองล่วงหน้าตามความเร็วตัวละคร (Look Ahead / Camera Lag)
    this.lookAheadX = 0;
    this.lookAheadY = 0;
    this.lookAheadSpeed = 0.05; // อัตราคืนตัวของกล้องมองล่วงหน้า

    // 3. ระบบเลนส์ขยายภาพเชิงรับ (Dynamic Zoom & Rotation)
    this.zoom = 1.0;
    this.targetZoom = 1.0;
    this.zoomSpeed = 0.08;
    this.angle = 0; // สำหรับการหมุนจอเวลาระเบิดลง

    // 4. ระบบจำลองแรงสะเทือนสมจริง (Trauma Camera Engine)
    this.trauma = 0.0;     // ค่าความเครียดสะสม (0.0 - 1.0)
    this.maxShakeX = 24;   // ระยะสั่นสูงสุดแนวแกน X (พิกเซล)
    this.maxShakeY = 24;   // ระยะสั่นสูงสุดแนวแกน Y
    this.maxAngle = 0.08;  // มุมเอียงสั่นสูงสุด (เรเดียน)
    this.traumaDecay = 1.6; // อัตราการลดลงของความสั่นสะเทือนต่อวินาที

    this.debugMode = false;
  }

  /**
   * ลงทะเบียนเป้าหมายหลักให้กล้องจับจ้อง
   */
  setTarget(entity, offsetX = 0, offsetY = 0) {
    this.target = entity;
    this.offsetX = offsetX;
    this.offsetY = offsetY;
  }

  /**
   * เพิ่มค่าความสั่นสะเทือนให้แก่ตัวกล้อง (สามารถสะสมซ้อนทับกันได้จากหลายทิศทาง)
   * @param {number} amount - ค่า Trauma ที่เพิ่มขึ้น (0.0 - 1.0)
   */
  addTrauma(amount) {
    this.trauma = Math.min(1.0, this.trauma + amount);
  }

  /**
   * ลูปอัปเดตตำแหน่งและการคำนวณคณิตศาสตร์ของระบบกล้องทั้งหมด
   * @param {number} dt - Fixed Delta Time
   */
  update(dt) {
    if (!this.target) return;

    const dtSec = dt / 1000;

    // --- 1. ระบบประมวลผลตำแหน่งเป้าหมายร่วมกับ DEAD ZONE ---
    const targetCenterX = this.target.x + (this.target.size / 2) + this.offsetX;
    const targetCenterY = this.target.y + (this.target.size / 2) + this.offsetY;

    // จุดกึ่งกลางปัจจุบันของหน้ากล้อง
    const camCenterX = this.x + this.width / 2;
    const camCenterY = this.y + this.height / 2;

    // คำนวณระยะห่างระหว่างเป้าหมายกับจุดศูนย์กลางกล้อง
    const deltaX = targetCenterX - camCenterX;
    const deltaY = targetCenterY - camCenterY;

    let desiredX = this.x;
    let desiredY = this.y;

    // ตรวจจับหากพิกัดตัวละครหลุดทะลุกรอบขอบเขต Dead Zone
    if (Math.abs(deltaX) > this.deadZone.width / 2) {
      desiredX += deltaX - (Math.sign(deltaX) * (this.deadZone.width / 2));
    }
    if (Math.abs(deltaY) > this.deadZone.height / 2) {
      desiredY += deltaY - (Math.sign(deltaY) * (this.deadZone.height / 2));
    }

    // --- 2. ระบบคำนวณกล้องมองล่วงหน้า (LOOK AHEAD SYSTEM) ---
    if (this.target.vx !== undefined && this.target.vy !== undefined) {
      const targetLAX = this.target.vx * 18; // ทวีคูณระยะมองล่วงหน้าตามความเร็วผู้เล่น
      const targetLAY = this.target.vy * 18;
      
      // ค่อยๆ ปรับมุมกล้องล่วงหน้าอย่างนุ่มนวล
      this.lookAheadX += (targetLAX - this.lookAheadX) * this.lookAheadSpeed;
      this.lookAheadY += (targetLAY - this.lookAheadY) * this.lookAheadSpeed;
      
      desiredX += this.lookAheadX;
      desiredY += this.lookAheadY;
    }

    // ระบบสมูทกล้องขั้นต้น (Lerp) นำพากล้องเข้าหาตำแหน่งที่เหมาะสม
    this.x += (desiredX - this.x) * 0.12;
    this.y += (desiredY - this.y) * 0.12;

    // ล็อกพิกัดกล้องให้อยู่ภายในขอบเขตของฉาก (Map Bounds Clamping)
    this.x = Math.max(0, Math.min(this.mapWidth - this.width, this.x));
    this.y = Math.max(0, Math.min(this.mapHeight - this.height, this.y));

    // --- 3. คำนวณระบบซูมภาพเชิงรับ (DYNAMIC ZOOM SMOOTHING) ---
    this.zoom += (this.targetZoom - this.zoom) * this.zoomSpeed;

    // --- 4. คำนวณค่าสะเทือนสไตล์ TRAUMA CAMERA ENGINE ---
    if (this.trauma > 0) {
      this.trauma = Math.max(0, this.trauma - this.traumaDecay * dtSec);
    }
  }

  /**
   * แปลงแมทริกซ์ Context และจัดมุมกล้องก่อนการเรนเดอร์ภาพ (รองรับ Pixel Perfect, Zoom, และ Roll Rotation)
   */
  applyTransform(ctx) {
    ctx.save();

    // เลื่อนศูนย์กลางไปที่กลางจอเพื่อให้ทำการหมุน (Rotate) และซูม (Zoom) ได้อย่างถูกต้องไม่บิดเบี้ยว
    ctx.translate(this.width / 2, this.height / 2);

    // ประมวลผลแรงสั่นสะเทือนแบบนอนเชิงเส้น (Non-linear Shake)
    if (this.trauma > 0) {
      const shakePower = Math.pow(this.trauma, 2); // คำนวณกำลังสองเพิ่มความธรรมชาติ
      const currentAngle = (Math.random() - 0.5) * this.maxAngle * shakePower;
      const currentShakeX = (Math.random() - 0.5) * this.maxShakeX * shakePower;
      const currentShakeY = (Math.random() - 0.5) * this.maxShakeY * shakePower;

      ctx.rotate(currentAngle);
      ctx.translate(currentShakeX, currentShakeY);
    }

    // เปิดใช้งานระบบ Zoom กำลังขยายหน้าจอ
    ctx.scale(this.zoom, this.zoom);

    // เลื่อนกลับไปยังจุดพิกัด World Space (ใช้ Math.round เพื่อประสิทธิภาพความคมชัดสูงสุดของเม็ดพิกเซล)
    ctx.translate(-Math.round(this.x + this.width / 2), -Math.round(this.y + this.height / 2));
  }

  /**
   * คืนค่าหน้าจอ Canvas สู่สภาวะปกติหลังเรนเดอร์ Entities เสร็จสิ้น
   */
  restoreTransform(ctx) {
    ctx.restore();
  }

  // --- 5. โมดูลคำนวณแปลงระบบพิกัดสลับมิติ (COORDINATE CONVERSION) ---

  /** แปลงจากตำแหน่งในโลก (World) มาเป็นพิกัดบนหน้าจอจริง (Screen) */
  worldToScreen(worldX, worldY) {
    return {
      x: Math.round((worldX - this.x - this.width / 2) * this.zoom + this.width / 2),
      y: Math.round((worldY - this.y - this.height / 2) * this.zoom + this.height / 2)
    };
  }

  /** แปลงจากตำแหน่งเมาส์บนจอ (Screen) กลับไปเป็นตำแหน่งในแผนที่เกม (World) */
  screenToWorld(screenX, screenY) {
    return {
      x: Math.round((screenX - this.width / 2) / this.zoom + this.x + this.width / 2),
      y: Math.round((screenY - this.height / 2) / this.zoom + this.y + this.height / 2)
    };
  }

  /**
   * ระบบตรวจสอบพื้นที่การมองเห็น (Frustum Culling / Visible Area Checking)
   * @param {Object} obj - วัตถุที่ต้องการเช็กพิกัดขอบเขต
   * @returns {boolean} true ถ้าอยู่ในจอภาพ พร้อมให้เรนเดอร์ภาพต่อได้
   */
  isVisible(obj) {
    const margin = obj.size || 32;
    return obj.x + margin >= this.x &&
           obj.x - margin <= this.x + this.width &&
           obj.y + margin >= this.y &&
           obj.y - margin <= this.y + this.height;
  }

  /**
   * ระบบวาดกรอบ Debug โหมดพัฒนาเกม (Debug Visualizer) สำหรับปุ่ม F3
   */
  drawDebug(ctx) {
    if (!this.debugMode) return;
    
    ctx.save();
    // วาดขอบเขตเส้นจำลองพิกัด Dead Zone กลางแผนที่
    ctx.strokeStyle = "rgba(234, 179, 8, 0.6)"; // สีทองโปร่งแสง
    ctx.lineWidth = 2;
    ctx.strokeRect(
      this.x + (this.width - this.deadZone.width) / 2,
      this.y + (this.height - this.deadZone.height) / 2,
      this.deadZone.width,
      this.deadZone.height
    );
    
    ctx.restore();
  }
}
